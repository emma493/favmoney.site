// Favmoney Firestore rules — paste into Firebase Console → Firestore → Rules.
// Auth: Email/Password (+ Google if re-enabled). No anonymous.
// Model is Firestore-only: no localStorage. Users touch only their own docs.
// Referral model: codes/{CODE} maps 6-letter code -> owner uid (immutable).
// referrals/{newUid} is the $0.50 invite claim filed by the new user, claimed by owner.
// commissions/{autoId} are lifetime % debts filed by the earner, claimed by owner.
// Grow model: wallets/{uid} holds invested principal (incl. locked $1 seed),
// investedAt (ms epoch), boostUntil (ms epoch, 0 = inactive). users/{uid} holds
// taskEarned (stakeable ceiling source), investedUser (user principal, excl. seed),
// activeDays (UTC-day strings with rewarded activity, max 90 — yield gate).
// Diamond model (play-only, never withdrawable): wallets/{uid} holds diamonds
// (integer chips) + lastDiamondAdAt / lastDiamondPassiveAt (ms epoch cooldowns).
// Spin model: users/{uid} holds lastSpinDay (UTC YYYY-MM-DD), spinTickets,
// spinCount, spinWon. proofs rows spin-win (cash 0.02-1.00) + spin-diamond /
// spin-ticket / spin-free / spin-extra (amount 0 bookkeeping).
// proofs rows with label diamond-* carry amount 0 (USD untouched) plus an
// optional signed diamonds delta for history.
// Admin model (Fav-Admin ops console): admin/owner holds the single-seat uid.
// isAdmin() unlocks cross-user list/get on users/wallets/proofs/cashouts/
// referrals/commissions, bounded wallet adjusts (shape-checked), audit proofs
// (any uid, amount <= 100, labelled), and cashout decisions review ->
// paid|rejected with nothing else changing. PASTE THIS FILE after editing.
// NOTE: client-side increments are validated for shape here; full authoritative
// accounting (server-set amounts) needs a Cloud Function when backend lands.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function self(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function authed() {
      return request.auth != null;
    }
    // Single-seat admin: the uid recorded in admin/owner. Powers below are
    // read-mostly; writes are tightly bounded (adjust <= $100 with a full
    // audit proof, cashouts review -> paid|rejected only). Full authority
    // still needs a backend; these rules only unlock an ops console.
    function isAdmin() {
      return authed()
        && exists(/databases/$(database)/documents/admin/owner)
        && get(/databases/$(database)/documents/admin/owner).data.uid == request.auth.uid;
    }
    function isCode(s) {
      return s is string && s.matches('^[A-Z]{6}$');
    }

    match /users/{userId} {
      allow read: if self(userId);
      allow list, get: if isAdmin();
      allow create: if self(userId)
        && request.resource.data.keys().hasOnly(['email', 'provider', 'createdAt', 'updatedAt', 'streak', 'started', 'claimedQuests', 'refcode', 'referredBy', 'myCode', 'taskEarned', 'investedUser', 'activeDays', 'lastSpinDay', 'spinTickets', 'spinCount', 'spinWon'])
        && (request.resource.data.email is string || request.resource.data.email == null)
        && (!('refcode' in request.resource.data) || request.resource.data.refcode == null || isCode(request.resource.data.refcode))
        && (!('myCode' in request.resource.data) || request.resource.data.myCode == null || isCode(request.resource.data.myCode))
        && (!('referredBy' in request.resource.data) || request.resource.data.referredBy == null || request.resource.data.referredBy is string)
        && (!('taskEarned' in request.resource.data) || (request.resource.data.taskEarned is number && request.resource.data.taskEarned >= 0))
        && (!('investedUser' in request.resource.data) || (request.resource.data.investedUser is number && request.resource.data.investedUser >= 0))
        && (!('lastSpinDay' in request.resource.data) || (request.resource.data.lastSpinDay is string))
        && (!('spinTickets' in request.resource.data) || (request.resource.data.spinTickets is number && request.resource.data.spinTickets >= 0))
        && (!('spinCount' in request.resource.data) || (request.resource.data.spinCount is number && request.resource.data.spinCount >= 0))
        && (!('spinWon' in request.resource.data) || (request.resource.data.spinWon is number && request.resource.data.spinWon >= 0))
        && (!('activeDays' in request.resource.data) || (request.resource.data.activeDays is list && request.resource.data.activeDays.size() <= 90));
      allow update: if self(userId)
        && request.resource.data.keys().hasOnly(['email', 'provider', 'createdAt', 'updatedAt', 'streak', 'started', 'claimedQuests', 'refcode', 'referredBy', 'myCode', 'taskEarned', 'investedUser', 'activeDays', 'lastSpinDay', 'spinTickets', 'spinCount', 'spinWon'])
        && (!('streak' in request.resource.data) || (request.resource.data.streak is map
          && request.resource.data.streak.days is number
          && request.resource.data.streak.last is string))
        && (!('claimedQuests' in request.resource.data) || request.resource.data.claimedQuests is list)
        && (!('started' in request.resource.data) || request.resource.data.started is map)
        && (!('refcode' in request.resource.data) || request.resource.data.refcode == null || isCode(request.resource.data.refcode))
        && (!('taskEarned' in request.resource.data) || (request.resource.data.taskEarned is number && request.resource.data.taskEarned >= 0))
        && (!('investedUser' in request.resource.data) || (request.resource.data.investedUser is number && request.resource.data.investedUser >= 0))
        && (!('activeDays' in request.resource.data) || (request.resource.data.activeDays is list && request.resource.data.activeDays.size() <= 90))
        // refcode + referredBy + myCode are write-once: once set, never change.
        && (!('refcode' in resource.data) || !('refcode' in request.resource.data) || request.resource.data.refcode == resource.data.refcode)
        && (!('referredBy' in resource.data) || !('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy)
        && (!('myCode' in resource.data) || !('myCode' in request.resource.data) || request.resource.data.myCode == resource.data.myCode)
        && (!('myCode' in request.resource.data) || request.resource.data.myCode == null || isCode(request.resource.data.myCode));
      allow delete: if false;
    }

    // Public code directory: CODE (doc id) -> owner uid. First-come ownership.
    match /codes/{codeId} {
      allow read: if authed();
      allow create: if authed()
        && codeId.matches('^[A-Z]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // One doc per invited user: filed by the new user, claimed by the owner.
    match /referrals/{newUid} {
      allow create: if authed()
        && newUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['code', 'ownerUid', 'newUid', 'amount', 'inviteeAmount', 'claimed', 'createdAt'])
        && isCode(request.resource.data.code)
        && request.resource.data.ownerUid is string
        && request.resource.data.newUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.amount == 0.5
        && request.resource.data.inviteeAmount == 1
        && request.resource.data.claimed == false;
      allow read: if authed()
        && (resource.data.ownerUid == request.auth.uid || resource.data.newUid == request.auth.uid);
      allow list: if isAdmin();
      // Owner flips claimed false -> true exactly once.
      allow update: if authed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true
        && resource.data.claimed == false;
      allow delete: if false;
    }

    // Lifetime commission debts: filed by the earner, claimed by the owner.
    match /commissions/{docId} {
      allow create: if authed()
        && request.resource.data.keys().hasOnly(['fromUid', 'ownerUid', 'baseAmount', 'commission', 'kind', 'claimed', 'at'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.baseAmount is number && request.resource.data.baseAmount > 0
        && request.resource.data.commission is number && request.resource.data.commission > 0
        && request.resource.data.commission <= request.resource.data.baseAmount * 0.26
        && (request.resource.data.kind == 'task' || request.resource.data.kind == 'offer')
        && request.resource.data.claimed == false;
      allow read: if authed()
        && (resource.data.ownerUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if authed()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
        && request.resource.data.claimed == true
        && resource.data.claimed == false;
      allow delete: if false;
    }

    match /wallets/{userId} {
      allow read: if self(userId);
      allow read: if isAdmin();
      allow create: if self(userId)
        && request.resource.data.pending is number && request.resource.data.pending >= 0
        && request.resource.data.lifetime is number && request.resource.data.lifetime >= 0
        && (!('invested' in request.resource.data) || (request.resource.data.invested is number && request.resource.data.invested >= 0))
        && (!('investedAt' in request.resource.data) || (request.resource.data.investedAt is number && request.resource.data.investedAt >= 0))
        && (!('boostUntil' in request.resource.data) || (request.resource.data.boostUntil is number && request.resource.data.boostUntil >= 0))
        && (!('diamonds' in request.resource.data) || (request.resource.data.diamonds is number && request.resource.data.diamonds >= 0))
        && (!('lastDiamondAdAt' in request.resource.data) || (request.resource.data.lastDiamondAdAt is number && request.resource.data.lastDiamondAdAt >= 0))
        && (!('lastDiamondPassiveAt' in request.resource.data) || (request.resource.data.lastDiamondPassiveAt is number && request.resource.data.lastDiamondPassiveAt >= 0));
      allow update: if self(userId)
        && request.resource.data.pending is number && request.resource.data.pending >= 0
        && request.resource.data.lifetime is number && request.resource.data.lifetime >= 0
        && (!('invested' in request.resource.data) || (request.resource.data.invested is number && request.resource.data.invested >= 0))
        && (!('investedAt' in request.resource.data) || (request.resource.data.investedAt is number && request.resource.data.investedAt >= 0))
        && (!('boostUntil' in request.resource.data) || (request.resource.data.boostUntil is number && request.resource.data.boostUntil >= 0))
        && (!('diamonds' in request.resource.data) || (request.resource.data.diamonds is number && request.resource.data.diamonds >= 0))
        && (!('lastDiamondAdAt' in request.resource.data) || (request.resource.data.lastDiamondAdAt is number && request.resource.data.lastDiamondAdAt >= 0))
        && (!('lastDiamondPassiveAt' in request.resource.data) || (request.resource.data.lastDiamondPassiveAt is number && request.resource.data.lastDiamondPassiveAt >= 0));
      // Admin manual adjust: same shape, any user. Audit proof written separately.
      allow update: if isAdmin()
        && request.resource.data.pending is number && request.resource.data.pending >= 0
        && request.resource.data.lifetime is number && request.resource.data.lifetime >= 0;
      allow delete: if false;
    }

    match /proofs/{docId} {
      allow create: if authed()
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && (
          (
            request.resource.data.uid == request.auth.uid
            && (
              request.resource.data.status == 'pending'
          || (
            request.resource.data.status == 'done'
            && (
              (request.resource.data.label == 'referral-invitee' && request.resource.data.amount == 1)
              || (request.resource.data.label == 'referral-inviter' && request.resource.data.amount == 0.5)
              || (request.resource.data.label.matches('referral-commission.*') && request.resource.data.amount > 0 && request.resource.data.amount <= 25)
              || (request.resource.data.label == 'invest-stake' && request.resource.data.amount > 0 && request.resource.data.amount <= 100)
              || (request.resource.data.label == 'invest-unstake' && request.resource.data.amount > 0 && request.resource.data.amount <= 100)
               || (request.resource.data.label == 'invest-yield' && request.resource.data.amount > 0 && request.resource.data.amount <= 50)
               || (request.resource.data.label == 'ad-view' && request.resource.data.amount == 0)
                // Spin the Wheel: cash wins 0.02-1.00, diamond/ticket/cost rows carry amount 0.
                || (request.resource.data.label == 'spin-win' && request.resource.data.amount >= 0.02 && request.resource.data.amount <= 1)
                || (request.resource.data.label == 'spin-diamond' && request.resource.data.amount == 0)
                || (request.resource.data.label == 'spin-ticket' && request.resource.data.amount == 0)
                || (request.resource.data.label == 'spin-free' && request.resource.data.amount == 0)
                || (request.resource.data.label == 'spin-extra' && request.resource.data.amount == 0)
               // Diamonds are play-only chips: all diamond moves carry amount 0
               // (USD untouched) with a signed diamonds delta for history.
               || (request.resource.data.label.matches('diamond-.*') && request.resource.data.amount == 0)
              )
            )
          )
          // Admin audit rows (manual adjust <= $100): any uid, labelled, bounded.
          || (
            isAdmin()
            && request.resource.data.uid is string
            && request.resource.data.label is string
            && request.resource.data.amount <= 100
            && (request.resource.data.status == 'pending' || request.resource.data.status == 'done')
          )
        );
      allow read: if authed() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Single-seat admin: the first authed user to claim admin/owner owns it
    // forever. Only the recorded owner uid can read it or set the TOTP secret.
    match /admin/owner {
      allow get: if authed() && resource.data.uid == request.auth.uid;
      allow create: if authed()
        && !exists(/databases/$(database)/documents/admin/owner)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'totpSecret'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && (request.resource.data.totpSecret == null || request.resource.data.totpSecret is string);
      allow update: if authed()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totpSecret']);
      allow delete: if false;
      allow list: if false;
    }

    match /cashouts/{docId} {
      allow create: if authed()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.amount is number && request.resource.data.amount >= 5
        && request.resource.data.status == 'review';
      allow read: if authed() && resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      // Admin decision: review -> paid|rejected, nothing else changes.
      allow update: if isAdmin()
        && resource.data.status == 'review'
        && request.resource.data.status in ['paid', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.amount == resource.data.amount;
      allow delete: if false;
    }
  }
}
