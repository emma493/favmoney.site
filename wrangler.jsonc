{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "favmoney",
  "compatibility_date": "2026-10-11",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "favmoney",
    "GG_SHARE": "0.7",
    "GG_MAX_PAYOUT": "20",
    "GG_CREDIT_EVENTS": "redeem,iclick",
    "OGADS_SHARE": "0.7",
    "OGADS_MAX_PAYOUT": "20",
    "MYLEAD_SHARE": "0.7",
    "MYLEAD_MAX_PAYOUT": "20",
    "MYLEAD_EURUSD": "1.08",
    "CPAGRIP_SHARE": "0.7",
    "CPAGRIP_MAX_PAYOUT": "20",
    "OFFERWALL_PUBLIC_API_KEY": "3NGWuhIgpEW2e3Y7rHtZ1ikVHAMnGA",
    "OFFERWALL_BEARER_TOKEN": "lInlF3jaKguGTktzBg0G4sCrja1EvkT3s6xkqgHq",
    "OFFERWALL_SECRET_KEY": "uMx7NS0zPjgUCIUz3W2HJedRLntWEclf"
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Custom domain, dashboard-attached: declared here so CLI deploys never
  // drop the favmoney.site route (wrangler warns + overrides otherwise).
  "routes": [
    { "pattern": "favmoney.site", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  }
}
